def cadastrarCliente(contadorN):
    nome = input("Digite o nome do cliente:")
    nome= nome.title()
    idade = int(input("Digite a idade do cliente:"))
    if (idade <18):
        print("Você é menor de idade")
        return contadorN
    else:
        print(f"Cliente: {nome} cadastrado(a)!")
        print(f"Sua identificação é: {contadorN}")
        
    cliente = [contadorN, nome, idade]
    clientes.append(cliente)
    with open("clientesdocedose.txt", "a", encoding="utf-8") as arquivo:
        arquivo.write(f"{contadorN}, {nome} , {idade}\n")

    contadorN += 1
    return contadorN

def encontrarCliente():
    idCliente = int(input("Digite o ID do cliente:"))
    clienteEncontrado = False
    for i in clientes:
        if (idCliente == i[0]):
            print(f"Cliente encontrado.ID: {i[0]}, nome: {i[1]}, idade: {i[2]}")
            clienteEncontrado = True
    if clienteEncontrado == False:
        print("Cliente não encontrado")

        
