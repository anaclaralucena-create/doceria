contadorV = 1
vendas = []

def cadastrarVenda(contadorV):
    idCliente = int(input("Digite o ID do cliente: "))

    for c in clientes:
        if (c[0] == idCliente):
            cliente = c
            break
    else:
        print("cliente não encontrado!")
        return contadorV

    idProduto = int(input("Digite o ID do produto: "))

    for p in produtos:
        if (p[0] == idProduto):
            produto = p
            break
    else:
        print("Produto não encontrado")
        return contadorV

    quantidade = int(input("Digite a quantidade da venda: "))

    if (quantidade <= 0):
        print("qantidade inválida")
        return contadorV

    if (quantidade > produto[4]):
        print("estoque insuficiente")
        return contadorV

    valorTotal = produto[3] * quantidade

    
    venda = [contadorV, idCliente, idProduto, produto[2], quantidade, produto[3], valorTotal]
    vendas.append(venda)

    produto[4] -= quantidade

    with open("vendasdocedose.txt", "a", encoding="utf-8") as arquivo:
        arquivo.write(f"{contadorV}, {idCliente}, {idProduto}, {produto[2]}, {quantidade}, {produto[3]}, {valorTotal}\n")
    with open("produtosdocedose.txt", "w", encoding="utf-8") as arquivo:
        for prod in produtos:
            arquivo.write(f"ID:{prod[0]};produto:{prod[1]};{prod[2]};valor:{prod[3]};quantidade:{prod[4]}\n")

    print("Venda cadastrada com sucesso!")
    print(f"ID da venda: {contadorV}")
    print(f"Valor total: R$ {valorTotal:.2f}")

    contadorV += 1
    return contadorV

def buscarVenda():
    idVenda = int(input("Digite o ID da venda: "))
    vendaEncontrada = False

    for v in vendas:
        if (idVenda == v[0]):
            print(f"""Venda encontrada: ID: {v[0]}, ID do cliente: {v[1]}, ID do produto: {v[2]}, produto: {v[3]},
quantidade: {v[4]}, valor unitário: R$ {v[5]:.2f}, valor total: R$ {v[6]:.2f}""")

            vendaEncontrada = True

    if vendaEncontrada == False:
        print("Venda não encontrada!")


def atualizarVenda():
    if len(vendas) == 0:
        print("Nenhuma venda cadastrada")
        return

    print("atualizar venda")
    buscID = int(input("Digite o ID da venda que deseja atualizar "))

    for v in vendas:
        if v[0] == buscID:
            print(f"Venda encontrada: {v}")
            print(f"Quantidade atual: {v[4]}")

            for p in produtos:
                if p[0] == v[2]:
                    produto = p
                    break
            else:
                print("Produto não encontrado!")
                return

            nova_quantidade = int(input("Digite nova quantidade: "))

            if nova_quantidade <= 0:
                print("Quantidade inválida!menos de 20")
                return

            estoqueDisponivel = produto[4] + v[4]

            if nova_quantidade > estoqueDisponivel:
                print("Estoque insuficiente")
                return

            produto[4] += v[4]
            produto[4] -= nova_quantidade

            v[4] = nova_quantidade
            v[6] = nova_quantidade * v[5]

            with open("vendasdocedose.txt", "w", encoding="utf-8") as arquivo:
                for venda in vendas:
                    arquivo.write(f"{venda[0]}, {venda[1]}, {venda[2]}, {venda[3]}, {venda[4]}, {venda[5]}, {venda[6]}\n")

            with open("produtosdocedose.txt", "w", encoding="utf-8") as arquivo:
                for prod in produtos:
                    arquivo.write(f"ID:{prod[0]};produto:{prod[1]};{prod[2]};valor:{prod[3]};quantidade:{prod[4]}\n")

            print("Venda atualizada com sucesso!")
            return

    print("Venda não encontrada!")

def excluirVenda():
    if len(vendas) == 0:
        print("Nenhuma venda cadastrada")
        return

    buscID = int(input("Digite o ID da venda que deseja excluir: "))

    for v in vendas:
        if v[0] == buscID:
            print(f"Venda encontrada: {v}")

            for p in produtos:
                if p[0] == v[2]:
                    p[4] += v[4]

            vendas.remove(v)

            with open("vendasdocedose.txt", "w", encoding="utf-8") as arquivo:
                for venda in vendas:
                    arquivo.write(f"{venda[0]}, {venda[1]}, {venda[2]}, {venda[3]}, {venda[4]}, {venda[5]}, {venda[6]}\n")

            with open("produtosdocedose.txt", "w", encoding="utf-8") as arquivo:
                for prod in produtos:
                    arquivo.write(f"ID:{prod[0]};produto:{prod[1]};{prod[2]};valor:{prod[3]};quantidade:{prod[4]}\n")

            print("Venda excluída com sucesso!")
            return

    print("Venda não encontrada!")

    
