def cadastrarCliente():
    nome = input("Digite o nome do cliente para o cadastro: ")
    nome= nome.title()
    idade = int(input("Digite a idade do cliente para o cadastro: "))

    if idade < 18:
        print("Cliente não pode ser cadastrado. Menor de idade.")
        return

    cpf = input("Digite o CPF para concluir o cadastro: ")
    cpf = cpf.replace("." , "")
    cpf = cpf.replace("-" , "")
    for cliente in clientesL:
        if cliente[1] == cpf:
            print("Esse CPF já foi cadastrado.")
            return

    print(f"Cliente cadastrado: {nome}. Com o CPF: {cpf}")
    clientesL.append([nome, cpf])

    with open("clientes.txt", "a", encoding="utf-8") as arquivo:
        arquivo.write(nome + ";" + cpf + "\n")


def encontrarCadastro():
    cpf = input("Digite o cpf do cliente que deseja encontrar: ")
    cpf = cpf.replace("." , "")
    cpf = cpf.replace("-" , "")
    for cliente in clientesL:
        if cliente[1] == cpf:
            print(f"Cliente encontrado: {cliente[0]}")
            break
    else:
        print("Cliente não encontrado.")
    
